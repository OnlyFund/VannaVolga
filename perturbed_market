class PerturbedMarket:
    def __init__(self, base_market: MarketData):
        self.base = base_market

    def bump_rr(self, delta: float, which="25") -> MarketData:
        key = f"rr_{which}"
        return self.base.copy_with(**{key: getattr(self.base, key) + delta})

    def bump_bf(self, delta: float, which="25") -> MarketData:
        key = f"bf_{which}"
        return self.base.copy_with(**{key: getattr(self.base, key) + delta})

    def scale_all_vols(self, factor: float) -> MarketData:
        return self.base.copy_with(
            v_atm=self.base.v_atm * factor,
            rr_25=self.base.rr_25 * factor,
            rr_10=self.base.rr_10 * factor,
            bf_25=self.base.bf_25 * factor,
            bf_10=self.base.bf_10 * factor,
        )

    def shift_spot(self, delta_spot: float) -> MarketData:
        return self.base.copy_with(S=self.base.S + delta_spot)
